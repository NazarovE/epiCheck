<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NoConnectActivity">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/signUpPageLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="50dp"
        android:adjustViewBounds="false"
        android:contentDescription="@string/logoimage_hont"
        android:src="@drawable/epicheck_logo"
        app:civ_border_color="@color/fiol_bleed"
        app:civ_border_width="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textNoInternet"
        tools:ignore="ImageContrastCheck" />

    <TextView
        android:id="@+id/textNoInternet"
        android:layout_width="361dp"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="200dp"
        android:layout_marginEnd="15dp"
        android:text="@string/NoConnect"
        android:textAlignment="center"
        android:textColor="@color/fiol"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>